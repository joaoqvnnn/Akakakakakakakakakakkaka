# ==================== BOT ====================
BOT_TOKEN=
BOT_USERNAME=larizinhastorebot

# ==================== ADMIN (dono) ====================
ADMIN_IDS=

# ==================== BANCO ====================
DATABASE_URL=postgresql+asyncpg://usuario:senha@localhost:5432/larizinha

# ==================== REDIS (anti-flood / cache) ====================
REDIS_URL=redis://localhost:6379/0

# ==================== MERCADO PAGO ====================
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=
MP_NOTIFICATION_URL=https://seudominio.onrender.com/webhook/mercadopago

# ==================== LOJA ====================
STORE_NAME=Larizinha Store
STORE_TIMEZONE=America/Sao_Paulo
SUPPORT_USERNAME=
SUPPORT_LINK=https://t.me/seu_suporte

# ==================== PIX ====================
PIX_EXPIRATION_MINUTES=10
PIX_MIN_VALUE=4.00
PIX_MAX_VALUE=5000.00

# ==================== BÔNUS ====================
BONUS_ENABLED=true
BONUS_PERCENT=10
BONUS_MIN_VALUE=10.00

# ==================== AFILIADOS ====================
AFFILIATE_ENABLED=true
AFFILIATE_COMMISSION_PERCENT=20
AFFILIATE_MIN_WITHDRAW=20.00

# ==================== WEBHOOK HTTP ====================
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8080
WEBHOOK_PATH=/webhook/mercadopago

# ==================== SAQUE WEB ====================
WITHDRAW_WEB_BASE_URL=https://seudominio.onrender.com
WITHDRAW_WEB_SECRET=troque_por_uma_chave_longa_e_aleatoria

# ==================== LOG ====================
LOG_LEVEL=INFO

# ==================== IA - LARIZINHA CHAT ====================
OPENAI_API_KEY=sk-proj-xxxx
OPENAI_MODEL=gpt-4o-mini
AI_CHAT_ENABLED=true
AI_CHAT_RATE_LIMIT_PER_MIN=6

# ==================== EMAIL SEGURO (NOVO) ====================
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=seu_email@seudominio.com
SMTP_PASS=sua_senha_do_email
EMAIL_FROM=Larizinha Store <seu_email@seudominio.com>
DELIVERY_LINK_BASE_URL=https://seudominio.onrender.com/delivery
DELIVERY_LINK_SECRET=outra_chave_longa_aleatoria_diferente_do_withdraw

# ==================== WHATSAPP BAILEYS ====================
BAILEYS_API_URL=http://localhost:3000
BAILEYS_API_KEY=sua_chave_baileys
